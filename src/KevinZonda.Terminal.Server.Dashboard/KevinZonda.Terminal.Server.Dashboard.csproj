<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="BuildDashboardAssets" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="pnpm install --frozen-lockfile" Condition="!Exists('$(MSBuildProjectDirectory)\node_modules\.pnpm\lock.yaml')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="pnpm run build" />
    <ItemGroup>
      <_DashboardAsset Include="$(MSBuildProjectDirectory)\dist\**\*" />
      <EmbeddedResource Include="@(_DashboardAsset)">
        <LogicalName>KevinZonda.Terminal.Server.Dashboard/%(_DashboardAsset.RecursiveDir)%(_DashboardAsset.Filename)%(_DashboardAsset.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
